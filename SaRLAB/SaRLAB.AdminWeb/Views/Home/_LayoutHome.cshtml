                            <a class="title title-menu col-6" asp-controller="Configuration" asp-action="GetAllUser">
                                Quản lý người
                                dùng</a>
                        </span>
                    </p>
                </li>
                <li class="@((ViewBag.ActiveMenu == "student") ? "active" : "")">
