                            <i class="icon fa-solid fa-image col-2"></i>
                            <a class="title title-menu col-6" asp-controller="Configuration" asp-action="GetAllBanner">Quản lý
                                trang web</a>
                        </span>
                    </p>
                </li>
                <li class="@((ViewBag.ActiveMenu == "user") ? "active" : "")">
