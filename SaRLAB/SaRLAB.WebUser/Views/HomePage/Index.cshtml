@{
    ViewData["Title"] = "Library Management";
    Layout = null;
    var schoolValue = TempData["School"] as int?;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.5">
    <title>@ViewData["Title"]</title>
    <!-- css -->
    <link rel="stylesheet" href="~/css/styles.css">
    <!-- icon-tab -->
    <link rel="icon" href="~/assets/icon/icon_tab.png">
    <!-- font -->
    <script src="https://kit.fontawesome.com/f0add9272d.js"></script>
</head>
<body>
    <div class="container">
        <!-- title - username -->
        <!-- title -->
        <div class="title-username">
            <div class="title">
                <h1>You are welcome!</h1>
            </div>
            <div class="username">
                @if (TempData["AvtPath"] != null && TempData["AvtPath"] is string avtPath && !string.IsNullOrWhiteSpace(avtPath))
                {
                        <img src="@Url.Content(TempData["AvtPath"].ToString())" alt="User Avatar">
                }
                else
                {
                        <img src="~/images/defaultAvatar.jpg" alt="Default Avatar">
                }

                @if (TempData["name"] != null && TempData["name"] is string name && !string.IsNullOrWhiteSpace(name))
                {
                        <span>@Html.Raw(name)</span>
                }
                else
                {
                        <span>Unknown User</span>
                }
            </div>

        </div>

        <!-- video -->
        <div class="video">
            <div class="form-video">
                <img src="~/assets/img/bg_book.gif" alt="" />
            </div>
        </div>

        <!-- sar-lab -->
        <div class="sarlab">
            <div class="new">
                <img src="~/assets/img/new.png" alt="">
            </div>
            <div class="sar">
                <p>SarLab</p>
                <h1>NEWS</h1>
            </div>
        </div>

        <!-- button -->
        <div class="event">
            <button class="library" onclick="window.location.href='@Url.Action("Index", "Library")'">
                <img id="bt-li" src="~/assets/img/button_li.png" alt="">
            </button>
            <button id="practiceRoomButton" class="library">
                <span>PHÒNG THỰC HÀNH</span>
            </button>

            @if (schoolValue == 1)
            {
                    <div class="notif">
                        Opps! Bạn cần liên hệ người quản lý đơn vị để được cấp mã vào phòng thực hành
                    </div>
                    <img id="lock" src="~/assets/img/lock.png" alt="">
            }
        </div>

        <!-- text -->
        <div class="text">
            <div class="content">
                <h2>BẢN QUYỀN</h2>
                <p>Tác giả cũng là chủ sở hữu phần mềm cam kết tính bảo mật, tính hợp pháp cho đơn vị khi đăng ký nhận chuyển nhượng.</p>
            </div>

            <div class="content">
                <h2>HƯỚNG DẪN SỬ DỤNG</h2>
                <p>Hướng dẫn sử dụng được thêm vào mỗi phòng thực hành theo đặc thù môn học. Để nhận bản đầy đủ vui lòng liên hệ tác giả phần mềm.</p>
            </div>

            <div class="content">
                <h2>THÔNG TIN LIÊN HỆ</h2>
                <p>Tác giả phần mềm: Đinh Quang Cảnh</p>
                <p>Số điện thoại: 0914.333.537</p>
                <p>E-mail: dinhquangcanh@ump.edu.vn</p>
            </div>
        </div>
    </div>
    <!-- scripts -->
    <script src="~/js/scripts.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var schoolValue = @schoolValue; // Giá trị TempData được chèn vào JavaScript

            document.getElementById('practiceRoomButton').addEventListener('click', function () {
                if (schoolValue != 1) {
                    window.location.href = '@Url.Action("Home", "HomePage")';
                }
            });
        });
    </script>

</body>
</html>
