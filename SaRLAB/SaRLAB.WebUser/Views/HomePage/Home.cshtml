@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Library- Management</title>
    <!-- css -->
    <link rel="stylesheet" href="~/css/styles.css" />
    <!-- icon-tab -->
    <link rel="icon" href="~/assets/icon/icon_tab.png" />
    <!-- font -->
    <script src="https://kit.fontawesome.com/f0add9272d.js"></script>
</head>

<body>
    <header>
        <div class="infor">
            <img src="@Url.Content(TempData["AvtPath"].ToString())" alt="">
            @if (TempData["name"] != null && TempData["name"] is string name && !string.IsNullOrWhiteSpace(name))
            {
                <h1>
                    <a asp-controller="HomePage" asp-action="Information" asp-route-subjectID="1">
                        @Html.Raw(name)
                    </a>
                </h1>

            }
            else
            {
                    <h1>Unknown User</h1>
            }
        </div>

        <div class="search">
            <h1>Chung</h1>
            <div class="tk">
                <input type="search" placeholder="Tìm kiếm">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <i class="fa-solid fa-bars"></i>
        </div>
    </header>
    <div class="container" id="li-index">
        <!-- header -->
        <div id="header-placeholder" class="men"></div>
        <!-- main -->
        <main>
            <!-- nav -->
            <nav class="note_f lab_menu">
                <div class="logo" id="x-1">
                    <h1>SaRLAB</h1>
                </div>
                <div class="menu" id="x-2">
                    <a href="@Url.Action("Index", "HomePage")">Chung</a>
                    <a href="@Url.Action("Index", "HomePage")">Trang chủ</a>
                    <a href="@Url.Action("Index", "Library")">Thư viện</a>
                    <a id="logout" href="@Url.Action("Logout", "HomePage")">Đăng xuất</a>

                </div>
            </nav>

            <!-- lab -->
            <div class="lab">
                <!-- fix -->
                @if (ViewBag.school.Banner != null)
                {
                    <img id="bg_lab" src="@Url.Content(ViewBag.school.Banner.ToString())" alt="" />
                }
                else
                {
                    <img id="bg_lab" src="~/assets/img/bg_lab.jpg" alt="" />
                }
                <div id="bg_bl"></div>

                <!-- data-lab -->
                @for (int i = 1; i <= 30; i++)
                {
                    var actionName = $"GetAllQuestion_Subject{i}";
                    <a href="@Url.Action(actionName, "MultipleQuestions")">
                        @if (ViewBag.school.GetType().GetProperty($"BackupSubject{i}Logo").GetValue(ViewBag.school) == null)
                        {
                            <img src="~/assets/img/lab1.jpg" alt="Image @i" />
                        }
                        else
                        {
                            <img src="@Url.Content(ViewBag.school.GetType().GetProperty($"BackupSubject{i}Logo").GetValue(ViewBag.school).ToString())"
                                alt="Image @i" />
                        }
                        <h1>@TempData[$"subject_{i}"]</h1>
                    </a>
                }


            </div>

            <div class="pagination_lab">
                <img id="p_lab" onclick="prevPage()" src="~/assets/icon/lab_button.png" alt="" />
                <span id="page-num"></span>
                <img id="n_lab" onclick="nextPage()" src="~/assets/icon/lab_button.png" alt="" />
                <div id="pagination-buttons"></div>
            </div>
        </main>
    </div>
    <!-- scripts -->
    <script src="~/js/lab.js"></script>
</body>

</html>
