@model SaRLAB.Models.Entity.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.5" />
    <title>Đăng ký</title>
    <link rel="stylesheet" href="~/css/signup.css" />
    <link rel="stylesheet" href="~/css/loginnew.css" />
</head>
<body>
    <div class="register-container">
        <form class="register-form" asp-action="Register">
            <h2>ĐĂNG KÝ</h2>
            <div class="input-box">
                <input type="text" asp-for="Name" required />
                <label>Họ và tên</label>
            </div>
            <div class="input-box">
                <input type="email" asp-for="Email" required />
                <label>Email</label>
            </div>
            <div class="input-box">
                <input type="text" asp-for="Phone" required />
                <label>Số điện thoại</label>
            </div>
            <div class="input-box">
                <input type="text" name="username" required />
                <label>Tên đăng nhập</label>
            </div>
            <div class="input-box">
                <input type="password" asp-for="Password" required />
                <label>Mật khẩu</label>
            </div>
            <div class="input-box">
                <input type="number" asp-for="SchoolId" required />
                <label>Mã trường</label>
            </div>

            <div class="message" id="loginMessage">
                <i>Vui lòng nhập thông tin</i>
            </div>

            <button type="submit">Gửi đăng ký</button>
        </form>
    </div>
</body>
</html>
