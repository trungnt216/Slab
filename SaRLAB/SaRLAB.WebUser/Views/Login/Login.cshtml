@model SaRLAB.Models.Entity.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.5" />
    <title>Login Form</title>
    <link rel="stylesheet" href="~/css/loginnew.css" />
</head>
<body>
    <div class="container">
        <form class="login-form" id="loginForm" asp-action="Login">
            <h2>ĐĂNG NHẬP</h2>
            <div class="input-box">
                <input type="text" asp-for="Email" required />
                <label>Tên đăng nhập</label>
            </div>
            <div class="input-box">
                <input type="password" asp-for="Password" required />
                <label>Password</label>
            </div>
            @if (TempData["Error"] != null)
                {
            <div class="message" id="loginMessage">
                    <i>@TempData["Error"]</i>
            </div>
            }

            <button class="login-btn" type="submit">Đăng nhập</button>
            <p>Bạn chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        </form>
    </div>

    <div class="title-sar">
        <h1>SarLAB</h1>
    </div>
    <script src="~/js/login.js"></script>
</body>
</html>