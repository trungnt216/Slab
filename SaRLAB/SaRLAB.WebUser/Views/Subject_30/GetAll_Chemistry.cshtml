@model IEnumerable<SaRLAB.Models.Entity.Equipment>

@{
    ViewData["Title"] = "GetAll_Chemistry";
    Layout = null;
    ViewBag.TitleCustom = "Danh sách " + ViewBag.ActiveSubMenuLv2.ToString();
    int counter = 1;
    int expiredItemCount = 0;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.5" />
    <!-- css -->
    <link rel="stylesheet" href="~/css/styles.css" />
    <!-- icon-tab -->
    <link rel="icon" href="~/assets/icon/icon_tab.png" />
    <!-- font -->
    <script src="https://kit.fontawesome.com/f0add9272d.js"></script>
</head>

<body>
    <div class="container" id="li-index">
        <!-- LAB -->
        <h1 id="vnx">CHemLAB</h1>
        <!-- header -->
        <!-- header -->
        <header>
            <div class="infor">
                <img src="@Url.Content(TempData["AvtPath"].ToString())" alt="">
                @if (TempData["name"] != null && TempData["name"] is string name && !string.IsNullOrWhiteSpace(name))
                {
                        <h1>
                            <a asp-controller="HomePage" asp-action="Information" asp-route-subjectID="1">
                            @TempData["name"]
                            </a>
                        </h1>

                }
                else
                {
                        <h1>Unknown User</h1>
                }
            </div>

            <div class="search">
                <i class="fa-solid fa-house" onclick="window.location.href='@Url.Action("Index", "HomePage")'"></i>
                <i class="fa-solid fa-bars" id="menu-btn"></i>
            </div>
        </header>

        <div class="menu_head">
            <a asp-action="GetAll_Document" asp-controller="HomePage" asp-route-titleDocument="giới thiệu">Giới thiệu</a>
            <a asp-action="GetAll_Document" asp-controller="HomePage" asp-route-titleDocument="văn bản biểu mẫu">Văn bản - Biểu mẫu</a>
            <a asp-action="GetAll_Document" asp-controller="HomePage" asp-route-titleDocument="hướng dẫn sử dụng">Hướng dẫn sử dụng</a>
            <a asp-action="GetAll_Document" asp-controller="HomePage" asp-route-titleDocument="hình ảnh">Kho hình ảnh</a>
            <a asp-action="GetAll_Document" asp-controller="HomePage" asp-route-titleDocument="liên hệ">Liên hệ</a>
        </div>


        <div class="olay" id="olay"></div>
        <!-- main -->
        <main>
            <!-- nav -->
            <nav class="note_f lab_menu">
                <div class="logo oil" id="x-1">
                    <h1>SaRLAB</h1>
                </div>
                <div class="menu oil" id="x-2">
                    <a href="@Url.Action("Index", "HomePage")">Trang chủ</a>
                    <a href="@Url.Action("Index", "Library")">Thư viện</a>
                    <a id="logout" href="@Url.Action("Logout", "HomePage")">Đăng xuất</a>
                </div>
            </nav>

            <!-- expected -->
            <div id="op" class="ti cl">
                <h1 id="tix">@ViewBag.TitleCustom</h1>
                <form method="get" action="@Url.Action("GetAll_Chemistry_Search")" class="tk">
                    <input type="search" name="name" placeholder="Tìm kiếm">
                    <input type="hidden" name="type" value="@ViewBag.ActiveSubMenuLv2">
                </form>
            </div>

            <!-- search -->
            <div class="search-ss">
                <div class="cc">
                    <div class="s-1">
                        <div class="table-container">
                            <table id="main-table" border="1" cellspacing="0" cellpadding="5">
                                <thead>
                                </thead>
                                <tbody>
                                    <!-- Data rows -->
                                    @foreach (var item in Model)
                                    {
                                            <tr>
                                                <td>@counter</td>
                                                <td>@Html.Raw(item.Name)</td>
                                                <td>@Html.Raw(item.From)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Unit1)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Unit1Amount)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Unit2)</td>
                                                <td>@(item.NormalDate.HasValue ? item.NormalDate.Value.ToString("dd/MM/yyyy")
                                                        : "")</td>
                                                <td style="display: none;">@(item.ExpiredDate.HasValue ?
                                            item.ExpiredDate.Value.ToString("dd/MM/yyyy")
                                            : "")</td>
                                                <td>
                                                    <img id="dtimg" src="@Url.Content(item.CoverImage)" alt="" />
                                                </td>
                                                <td id="tt-p">
                                                    <a asp-action="Details_Chemistry" asp-route-type="@ViewBag.ActiveSubMenuLv2"
                                                        asp-route-id="@item.ID">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit_Chemistry" asp-route-type="@ViewBag.ActiveSubMenuLv2"
                                                        asp-route-id="@item.ID">
                                                        <i class="fa-solid fa-pen-to-square"></i>
                                                    </a>
                                                    <a asp-action="Delete_Chemistry" asp-route-type="@ViewBag.ActiveSubMenuLv2"
                                                        asp-route-id="@item.ID">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        counter++;
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="pagination" id="oki">
                        <button id="prev" disabled>
                            <img src="~/assets/icon/lab_button.png" alt="" />
                        </button>
                        <span id="page-info"></span>
                        <button id="next">
                            <img src="~/assets/icon/lab_button.png" alt="" />
                        </button>
                    </div>
                </div>
                <div class="xp">
                    <form asp-action="Create_Chemistry" asp-route-type="@ViewBag.ActiveSubMenuLv2" method="post">
                        <button id="add-s" type="submit">
                            <span>Thêm mới</span>
                        </button>
                    </form>

                </div>
            </div>
        </main>
    </div>
    <!-- scripts -->

    <script>
        const menuBtn = document.getElementById("menu-btn");
        if (menuBtn) {
            const menuHead = document.querySelector(".menu_head");
            const header = document.querySelector("header");
            const olay = document.getElementById("olay");

            menuBtn.addEventListener("click", () => {
                menuHead.classList.toggle("active");
                olay.classList.toggle("active");
            });

            olay.addEventListener("click", () => {
                menuHead.classList.remove("active");
                olay.classList.remove("active");
            });
        } else {
            console.error("Phần tử menuBtn không tồn tại trong DOM.");
        }
    </script>
    <script src="~/js/tablenew.js"></script>

    <!-- setup-time -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            function parseDate(dateStr) {
                const [day, month, year] = dateStr.split("/");
                return new Date(`${year}-${month}-${day}`);
            }


            const current = new Date();

            const rows = document.querySelectorAll("#main-table tbody tr");

            rows.forEach((row) => {
                // Trích xuất thời gian từ ô thứ 8
                const time1Str = row.querySelectorAll("td")[7].textContent.trim();
                const time1 = parseDate(time1Str);
                // Trích xuất thời gian từ ô thứ 7
                const time2Str = row.querySelectorAll("td")[6].textContent.trim();
                const time2 = parseDate(time2Str);

                console.log(current);
                console.log(time1);
                console.log(time2);

                if (current < time1 && time1 < time2) {
                    row.classList.add("row-green");
                } else if (time1 < current && current < time2) {
                    row.classList.add("row-yellow");
                } else if (time1 < time2 && current > time2) {
                    row.classList.add("row-red");
                }
            });
        });
    </script>

    <!-- page-data -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            function decodeHtml(html) {
                const txt = document.createElement("textarea");
                txt.innerHTML = html;
                return txt.value;
            }

            function createTableHeader() {
                const activeSubMenu = decodeHtml("@ViewBag.ActiveSubMenuLv2".trim());

            // Debugging output to ensure correct value
                console.log("Active SubMenu:", activeSubMenu);

                let headerHtml = "";
                if (activeSubMenu == "hoá chất" || activeSubMenu == "dự trù hoá chất") {
                    headerHtml = `
                        <tr>
                            <th>STT</th>
                            <th>Tên hoá chất</th>
                            <th>Nguồn gốc</th>
                            <th>Quy cách</th>
                            <th>Số lượng</th>
                            <th>Đơn vị</th>
                            <th>Hạn sử dụng</th>
                            <th>NFPA</th>
                            <th>Chi tiết</th>
                        </tr>`;
                } else {
                    headerHtml = `
                        <tr>
                            <th>STT</th>
                            <th>Tên dụng cụ</th>
                            <th>Nguồn gốc</th>
                            <th>Quy cách</th>
                            <th>Số lượng</th>
                            <th>Đơn vị</th>
                            <th>Ngày hiệu chuẩn</th>
                            <th>Hình minh hoạ</th>
                            <th>Chi tiết</th>
                        </tr>`;
                }
                return headerHtml;
            }

            function createTableFromRows(rows) {
                const table = document.createElement("table");
                table.border = 1;
                table.cellSpacing = 0;
                table.cellPadding = 5;

                const thead = document.createElement("thead");
                thead.innerHTML = createTableHeader();
                table.appendChild(thead);

                const tbody = document.createElement("tbody");
                rows.forEach((row) => tbody.appendChild(row));
                table.appendChild(tbody);

                return table;
            }

            function renderPage(page) {
                tableContainer.innerHTML = "";
                const startIndex = (page - 1) * tablesPerPage * rowsPerPage;
                const endIndex = Math.min(
                    startIndex + tablesPerPage * rowsPerPage,
                    allRows.length
                );

                const pageDiv = document.createElement("div");
                pageDiv.classList.add("table-page");

                for (let i = startIndex; i < endIndex; i += rowsPerPage) {
                    const rowsForTable = allRows.slice(i, i + rowsPerPage);
                    pageDiv.appendChild(createTableFromRows(rowsForTable));
                }

                tableContainer.appendChild(pageDiv);

                pageInfo.textContent = `Page ${currentPage}`;
                prevButton.disabled = currentPage === 1;
                nextButton.disabled = endIndex >= allRows.length;
            }

            const allRows = Array.from(mainTable.querySelectorAll("tbody tr"));
            let currentPage = 1;

            prevButton.addEventListener("click", () => {
                if (currentPage > 1) {
                    currentPage--;
                    renderPage(currentPage);
                }
            });

            nextButton.addEventListener("click", () => {
                if (currentPage * tablesPerPage * rowsPerPage < allRows.length) {
                    currentPage++;
                    renderPage(currentPage);
                }
            });

            renderPage(currentPage);
        });
    </script>
</body>

</html>
