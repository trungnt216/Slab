@{
    ViewData["Title"] = "Index";
    Layout = ViewBag.Layout;
}

<section class="hero hero-subject d-flex flex-column justify-content-center align-items-center" id="home">
    <div class="image-background">
        @if (TempData["BackGround"] != null)
        {
                            <img src="@Url.Content(TempData["BackGround"].ToString())" alt="Background Image">
        }
        else
        {
                            <img src="@Url.Content("~/images/bannerChem.png")" alt="Default Background Image">
        }
    </div>
    <div class="bg-overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-md-10 mx-auto col-12">
                <div class="hero-text mt-5 text-center">
                    <h1 class="text-white wow fadeInRight" data-wow-duration="1s" data-wow-delay="0.5s"
                        style="font-size: 65px !important;">
                        Welcome to <span style="color: #D6C187 !important;">@TempData["Subject_1"]</span>
                    </h1>
                    <div class="group-home d-flex wow fadeInLeft" data-wow-duration="1s" data-wow-delay="0.8s">
                        <a class="group-btn-home group-rules d-flex" asp-controller="Subject_30"
                            asp-action="Details_RuleClassroom">
                            <img class="img-rules" src="@Url.Content("~/images/rules.png")" />
                            <p>Nội quy<br>phòng thí nghiệm</p>
                        </a>
                        <a class="group-btn-home group-news d-flex" asp-controller="Subject_30" asp-action="GetAll_New">
                            <img class="img-news" src="@Url.Content("~/images/news.png")" />
                            <p>Tin tức - News</p>
                            @* <label class="txt-news">New</label> *@
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="text-center" style="background-color: #111111; color: #D6C187; padding: 5px 0; position: fixed; bottom: 0; width: 100%; z-index: 10;">
    <div class="container" style="padding: 0; display: flex; justify-content: space-between;">
        <div style="text-align: left;">
            <p style="color: #D6C187;font-size: 12px; line-height: 15px;">&copy; Author: Dinh Quang Canh.</p>
            <p style="color: #D6C187;font-size: 12px; line-height: 15px;"><a href="#" style="color: #D6C187;">Email: dinhquangcanh@ump.edu.vn - Contact: +84 914 33 35 37</a></p>
        </div>
        <div style="text-align: right;">
            <p style="color: #D6C187;font-size: 12px; line-height: 15px;">Version: 1.0.0</p>
        </div>
    </div>
</footer>


<style>
    /* Styles for the image background */
    .image-background {
        position: absolute; /* Make sure it sits behind other content */
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh; /* Full viewport height */
        overflow: hidden;
        z-index: -1; /* Ensure it stays behind other content */
    }

        .image-background img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.4;  /* 70% opacity */
        }

    /* Optional overlay for additional opacity effect */
    .bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5); /* Optional: overlay for additional opacity effect */
        z-index: 0;
    }

    /* Ensure footer remains fixed at the bottom */
    footer {
        background-color: #111111;
        color: #D6C187;
        padding: 5px 0;
        position: fixed;
        bottom: 0;
        width: 100%;
        z-index: 10;
    }

        footer .container {
            padding: 0;
            display: flex;
            justify-content: space-between;
        }

            footer .container div {
                text-align: left;
            }

        footer p {
            color: #D6C187;
            font-size: 12px;
            line-height: 15px;
        }

        footer a {
            color: #D6C187;
        }
</style>