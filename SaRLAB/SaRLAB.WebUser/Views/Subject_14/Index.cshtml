@{
    ViewData["Title"] = "Index";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.5" />
    <title>Library- Management</title>
    <!-- css -->
    <link rel="stylesheet" href="~/css/styles.css" />
    <!-- icon-tab -->
    <link rel="icon" href="~/assets/icon/icon_tab.png" />
    <!-- font -->
    <script src="https://kit.fontawesome.com/f0add9272d.js"></script>
</head>

<body>
    <div class="container" id="li-index">
        <!-- header -->
        <header>
            <div class="infor">
                <img src="@Url.Content(TempData["AvtPath"].ToString())" alt="">
                @if (TempData["name"] != null && TempData["name"] is string name && !string.IsNullOrWhiteSpace(name))
                {
                            <h1>
                                <a asp-controller="HomePage" asp-action="Information" asp-route-subjectID="1">
                            @TempData["name"]
                                </a>
                            </h1>

                }
                else
                {
                            <h1>Unknown User</h1>
                }
            </div>

            <div class="search">
                <h1 onclick="window.location.href='@Url.Action("Index", "HomePage")'">Chung</h1>
                <div class="tk">
                    <input type="search" placeholder="Tìm kiếm">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <i class="fa-solid fa-bars"></i>
            </div>
        </header>
        <!-- main -->
        <main>
            <!-- nav -->
            <nav class="note_f lab_menu">
                <div class="logo" id="x-1">
                    <h1>SaRLAB</h1>
                </div>
                <div class="menu" id="x-2">
                    <a href="@Url.Action("Index", "HomePage")">Chung</a>
                    <a href="@Url.Action("Index", "HomePage")">Trang chủ</a>
                    <a href="@Url.Action("Index", "Library")">Thư viện</a>
                    <a id="logout" href="@Url.Action("Logout", "HomePage")">Đăng xuất</a>
                </div>
            </nav>
            <!-- lab-detail -->
            <div class="lab-detail">
                <img id="pk" src="~/assets/img/bg_detail_lab.png" alt="" />
                @if (TempData["BackGround"] != null)
                {
                            <img id="pk" src="@Url.Content(TempData["BackGround"].ToString())" alt="" />
                }
                else
                {
                            <img id="pk" src="~/assets/img/bg_detail_lab.png" alt="" />
                }
                <div class="ti">

                    <img src="~/assets/img/bank_lab.png" alt="" />
                    <h1>@TempData["Subject_1"]</h1>
                </div>
                <div class="fl-ti">
    <div class="column">
        <a class="me-box" asp-action="Title_GetAll_By_Type" asp-route-id="0" asp-route-type="Kho vật tư">Kho vật tư</a>
        <a asp-controller="Subject_14" asp-action="Title_GetAll_By_Type" asp-route-id="4" asp-route-type="Nghiên cứu khoa học" class="me-box">Nghiên cứu khoa học</a>
    </div>
    <div class="column">
        <a asp-controller="Subject_14" asp-action="Title_GetAll_By_Type" asp-route-id="2" asp-route-type="Thực hành" class="big-box">Thực hành</a>
        <a asp-controller="Subject_14" asp-action="Title_GetAll_By_Type" asp-route-id="5" asp-route-type="Tiếng Anh chuyên ngành" class="small-box">Tiếng Anh chuyên ngành</a>
    </div>
    <div class="column">
        <a asp-action="Title_GetAll_By_Type" asp-route-id="0" asp-route-type="Nhân sự" class="small-box">Nhân sự</a>
        <a asp-controller="Subject_14" asp-action="Title_GetAll_By_Type" asp-route-id="1" asp-route-type="Tài liệu" class="small-box">Tài liệu</a>
        <a asp-controller="Subject_14" asp-action="Title_GetAll_By_Type" asp-route-id="3" asp-route-type="Hợp tác quốc tế" class="small-box" class="small-box">Hợp tác quốc tế</a>
    </div>
</div>
            </div>
        </main>
    </div>
    <!-- scripts -->
    <script src="~/js/lab.js"></script>
</body>

</html>
