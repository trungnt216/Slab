@model SaRLAB.Models.Entity.Subject

@{
    ViewData["Title"] = "Details_RuleClassroom";
    Layout = "~/Views/Chemistry/_LayoutChem.cshtml";
    ViewBag.TitleCustom = "Nội quy phòng thí nghiệm";
}

<div id="sub-content">
    <div class="container">
        <div class="row">
            <div class="col-12 detail-container">
                <dl class="row">
                    <div class="">
                        <div class="detail-item">
                            <div class="title">
                                <i class="fa-regular fa-file"></i>
                                <p>An toàn phòng thí nghiệm</p>
                            </div>
                        </div>
                            @if (string.IsNullOrEmpty(Model.Rule))
                        {
                            <span style="color: #5d6975; font-style: italic; padding-left: 25px;">Không có sẵn file
                                nào!</span>
                        }
                        else
                        {
                                string path = Model.Rule;
                            string extension = System.IO.Path.GetExtension(path).ToLower();
                            if (extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif")
                            {
                                <img src="@Url.Content(path)" alt="Image" style="max-width: 100%; height: auto;" />
                            }
                            else if (extension == ".mp4" || extension == ".webm" || extension == ".ogg")
                            {
                                <video width="100%" height="auto" controls>
                                    <source src="@Url.Content(path)" type="video/@extension.Substring(1)">
                                    Your browser does not support the video tag.
                                </video>
                            }
                            else if (extension == ".pdf")
                            {
                                <object class="pdf" data="@Url.Content(path)" width="100%" height="800">
                                </object>
                            }
                            else if (Model.Rule.Contains("youtube.com/embed"))
                            {
                                <iframe style="width: 100%; height: 300px;" src="@Model.Rule" frameborder="0" allowfullscreen></iframe>
                            }
                            else
                            {
                                <p class="form-text-danger">Không hỗ trợ file!</p>
                            }
                        }
                    </div>
                    
                </dl>
            </div>
        </div>
    </div>
</div>
