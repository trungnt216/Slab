<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Microsoft.Maui.Controls.Compatibility;assembly=Microsoft.Maui.Controls.Compatibility"
             x:Class="SaRLAB.Mobile.View.SubjectListPage"
             xmlns:local="clr-namespace:SaRLAB.Mobile.ViewModels"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.BindingContext>
        <local:SubjectViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <Grid>
            <!-- Define Row Definitions -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Logo and Welcome Row -->
                <RowDefinition Height="Auto"/>
                <!-- List Items Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Row -->
            </Grid.RowDefinitions>

            <!-- Background Image -->
            <Image Source="bg_main.png"
                   Aspect="AspectFill"
                   Grid.RowSpan="5"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand" />

            <!-- Header -->
            <StackLayout Grid.Row="0" Padding="25">
                <Label Text="Đại học Y Dược Thành phố Hồ Chí Minh"
                       FontSize="20"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       TextTransform="Uppercase"
                       FontAttributes="Bold"
                       LineHeight="1.2"/>
            </StackLayout>

            <!-- Logo and Welcome Text -->
            <StackLayout Grid.Row="1" Padding="10, 60, 10, 20">
                <Image Source="logo.png" Aspect="AspectFit" WidthRequest="150"/>
                <Label Text="Welcome to SaRLAB"
                       Margin="0, 15"
                       FontSize="30"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       TextTransform="Uppercase"
                       FontAttributes="Bold"/>
            </StackLayout>

            <!-- List of Menu Items -->
            <StackLayout Grid.Row="2" Padding="0" HeightRequest="250" WidthRequest="350">
                <CarouselView ItemsSource="{Binding Subjects}" PeekAreaInsets="8" IndicatorView="indicatorView">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="20" HasShadow="True" Padding="0" Margin="10" BackgroundColor="{Binding SubjectBackground}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSubjectTapped"/>
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="{Binding SubjectLogo}" HeightRequest="80" Margin="0, 25, 0, 0"/>
                                    <Label Grid.Row="1" Text="{Binding SubjectName}" 
                               FontSize="25"
                               HorizontalOptions="Center" 
                               VerticalOptions="End" 
                               TextColor="White" 
                               Margin="20, 10, 20, 20"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView 
                    x:Name="indicatorView"
                    Grid.Row="3"
                    HorizontalOptions="Center"
                    IndicatorColor="#616161"
                    IndicatorSize="8"
                    SelectedIndicatorColor="White"
                    Margin="0, 10"
                    VerticalOptions="Center"/>
            </StackLayout>
            <!-- Footer Label -->
            <Label Grid.Row="4"
                   Text="HSSV cần trả lời câu hỏi trắc nghiệm để truy cập vào phòng thực hành!"
                   FontSize="14"
                   LineHeight="1.2"
                   FontAttributes="Italic"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="End"
                   Padding="25, 20"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
