<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Microsoft.Maui.Controls.Compatibility;assembly=Microsoft.Maui.Controls.Compatibility"
             x:Class="SaRLAB.Mobile.View.SubjectListPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <Grid>
            <!-- Define Row Definitions -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Logo and Welcome Row -->
                <RowDefinition Height="Auto"/>
                <!-- List Items Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Row -->
            </Grid.RowDefinitions>

            <!-- Background Image -->
            <Image Source="bg_main.png"
                   Aspect="AspectFill"
                   Grid.RowSpan="5"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand" />

            <!-- Header -->
            <StackLayout Grid.Row="0" Padding="25">
                <Label Text="Đại học Y Dược Thành phố Hồ Chí Minh"
                       FontSize="20"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       TextTransform="Uppercase"
                       FontAttributes="Bold"
                       LineHeight="1.2"/>
            </StackLayout>

            <!-- Logo and Welcome Text -->
            <StackLayout Grid.Row="1" Padding="10, 50">
                <Image Source="logo.png" Aspect="AspectFit" WidthRequest="150"/>
                <Label Text="Welcome to SaRLAB"
                       Margin="0, 10"
                       FontSize="30"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       TextTransform="Uppercase"
                       FontAttributes="Bold"/>
            </StackLayout>

            <!-- List of Menu Items -->
            <StackLayout Grid.Row="2" Padding="20">
               <ListView ItemsSource="{Binding MenuItems}" ItemTapped="OnSubjectTapped" BackgroundColor="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextCell Text="{Binding Title}" TextColor="White"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>

            <!-- Footer Label -->
            <Label Grid.Row="4"
                   Text="HSSV cần trả lời câu hỏi trắc nghiệm để truy cập vào phòng thực hành!"
                   FontSize="14"
                   LineHeight="1.2"
                   FontAttributes="Italic"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="End"
                   Padding="25, 20"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
